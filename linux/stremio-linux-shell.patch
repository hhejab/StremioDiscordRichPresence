+#[test]
+fn worker_connects_deduplicates_disables_reconnects_and_cleans_up() {
+    let (sender, receiver) = flume::unbounded();
+    let (events, output) = flume::unbounded();
+    let connected = Arc::new(AtomicBool::new(false));
+    let client = FakeClient {
+        events,
+        fail_write: Arc::new(AtomicBool::new(false)),
+        fail_connect: Arc::new(AtomicBool::new(false)),
+        last: Arc::new(Mutex::new(None)),
+    };
+    let status = connected.clone();
+    let worker = thread::spawn(move || run(receiver, status, client, RETRY_INTERVAL));
+    let next = || output.recv_timeout(Duration::from_secs(2)).unwrap();
+    assert_eq!(next(), json!("connect"));
+    assert_eq!(next(), Value::Null);
+    let presence = Presence {
+        details: "A film".into(),
+        image: Some("https://example.com/poster.jpg".into()),
+        paused: false,
+        ..Presence::default()
+    };
+    sender
+        .send(Command::Update(Some(presence.clone())))
+        .unwrap();
+    let activity = next();
+    assert_eq!(activity["details"], "A film");
+    assert_eq!(
+        activity["assets"]["large_image"],
+        "https://example.com/poster.jpg"
+    );
+    sender
+        .send(Command::Update(Some(presence.clone())))
+        .unwrap();
+    sender.send(Command::Enable(false)).unwrap();
+    assert_eq!(next(), Value::Null); // duplicate update was not sent
+    assert_eq!(next(), json!("close"));
+    sender
+        .send(Command::Update(Some(Presence {
+            paused: true,
+            ..presence
+        })))
+        .unwrap();
+    sender.send(Command::Enable(true)).unwrap();
+    assert_eq!(next(), json!("connect"));
+    assert_eq!(next()["state"], "Paused");
+    sender.send(Command::Shutdown).unwrap();
+    assert_eq!(next(), Value::Null);
+    assert_eq!(next(), json!("close"));
+    worker.join().unwrap();
+    assert!(!connected.load(Ordering::Relaxed));
+}
