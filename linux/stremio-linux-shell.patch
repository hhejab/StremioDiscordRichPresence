+#[test]
+fn metadata_before_start_pause_resume_stop_and_late_events() {
+    let (discord, _) = controller();
+    discord.set_metadata(
+        "Pilot (1x1)".into(),
+        Some("A series".into()),
+        Some("https://example.com/art.jpg".into()),
+    );
+    assert!(discord.playback.borrow().presence().is_none());
+    discord.playback_started();
+    let presence = discord.playback.borrow().presence().unwrap();
+    assert_eq!(presence.details, "A series");
+    assert_eq!(
+        presence.image.as_deref(),
+        Some("https://example.com/art.jpg")
+    );
+    assert!(!presence.paused);
+    discord.set_paused(true);
+    assert!(discord.playback.borrow().presence().unwrap().paused);
+    discord.clear_activity();
+    assert!(discord.playback.borrow().presence().is_some());
+    discord.set_paused(false);
+    assert!(!discord.playback.borrow().presence().unwrap().paused);
+    discord.playback_ended("stop");
+    discord.set_paused(true); // frontend cleanup is a pause, not another stop/start
+    discord.set_activity("Late title".into(), "Watching".into(), None);
+    assert!(discord.playback.borrow().presence().is_none());
+    discord.playback_started();
+    assert!(discord.playback.borrow().presence().is_none()); // no stale title
+}
