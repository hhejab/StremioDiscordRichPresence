+#[test]
+fn metadata_after_start_redirect_replacement_and_terminal_events() {
+    let (discord, _) = controller();
+    discord.playback_started();
+    discord.set_metadata("Movie".into(), None, None);
+    discord.playback_ended("redirect");
+    assert!(discord.playback.borrow().presence().is_some());
+    discord.set_metadata("Next episode (1x2)".into(), Some("Series".into()), None);
+    discord.prepare_playback();
+    discord.playback_ended("stop");
+    assert!(discord.playback.borrow().presence().is_none());
+    discord.playback_started();
+    assert_eq!(
+        discord.playback.borrow().presence().unwrap().details,
+        "Series"
+    );
+    for reason in ["eof", "error", "quit", "stop", "other"] {
+        discord.playback_started();
+        discord.set_metadata("Movie".into(), None, None);
+        discord.playback_ended(reason);
+        assert!(discord.playback.borrow().presence().is_none());
+        assert!(discord.playback.borrow().metadata.is_none());
+    }
