+struct FakeClient {
+    events: Sender<Value>,
+    fail_write: Arc<AtomicBool>,
+    fail_connect: Arc<AtomicBool>,
+    last: Arc<Mutex<Option<Value>>>,
+}
+
+impl DiscordIpc for FakeClient {
+    fn connect(&mut self) -> Result<(), Error> {
+        self.events.send(json!("connect")).unwrap();
+        if self.fail_connect.load(Ordering::Relaxed) {
+            return Err(Error::IPCNotFound);
+        }
+        Ok(())
+    }
+    fn set_activity(&mut self, activity: Activity) -> Result<(), Error> {
+        if self.fail_write.swap(false, Ordering::Relaxed) {
+            return Err(Error::NotConnected);
+        }
+        let payload = serde_json::to_value(activity).unwrap();
+        *self.last.lock().unwrap() = Some(payload.clone());
+        self.events.send(payload).unwrap();
+        Ok(())
+    }
+    fn clear_activity(&mut self) -> Result<(), Error> {
+        self.events.send(Value::Null).unwrap();
+        Ok(())
+    }
+    fn close(&mut self) -> Result<(), Error> {
+        self.events.send(json!("close")).unwrap();
+        Ok(())
+    }
+    fn get_client_id(&self) -> &str {
+        CLIENT_ID
+    }
+    fn connect_ipc(&mut self) -> Result<(), Error> {
+        unreachable!()
+    }
+    fn write(&mut self, _: &[u8]) -> Result<(), Error> {
+        unreachable!()
+    }
+    fn read(&mut self, _: &mut [u8]) -> Result<(), Error> {
+        unreachable!()
+    }
+}
