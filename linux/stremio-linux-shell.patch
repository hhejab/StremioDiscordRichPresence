+#[test]
+fn playback_clock_is_stable_seeks_and_speed_changes_update_it_and_pause_removes_it() {
+    let mut playback = Playback {
+        active: true,
+        metadata: Some(Presence {
+            details: "Movie".into(),
+            ..Presence::default()
+        }),
+        position: Some(30.0),
+        duration: Some(120.0),
+        speed: 1.0,
+        ..Playback::default()
+    };
+    playback.update_clock(1000);
+    assert_eq!(playback.clock, Some((970, Some(1090))));
+    playback.position = Some(31.0);
+    playback.update_clock(1001);
+    assert_eq!(playback.clock, Some((970, Some(1090))));
+    playback.position = Some(60.0);
+    playback.update_clock(1001);
+    assert_eq!(playback.clock, Some((941, Some(1061))));
+    let payload = serde_json::to_value(playback.presence().unwrap().activity()).unwrap();
+    assert_eq!(payload["timestamps"]["end"], 1061);
+    playback.paused = true;
+    playback.update_clock(1002);
+    assert!(playback.clock.is_none());
+    let payload = serde_json::to_value(playback.presence().unwrap().activity()).unwrap();
+    assert!(payload.get("timestamps").is_none());
+    playback.paused = false;
+    playback.speed = 2.0;
+    playback.update_clock(1010);
+    assert_eq!(playback.clock, Some((980, Some(1040))));
+}
