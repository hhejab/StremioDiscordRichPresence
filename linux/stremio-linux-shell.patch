+use super::*;
+use discord_rich_presence::error::Error;
+use serde_json::{Value, json};
+use std::sync::Mutex;
+
+fn controller() -> (Discord, Receiver<Command>) {
+    let (sender, receiver) = flume::unbounded();
+    (
+        Discord {
+            playback: RefCell::default(),
+            sender,
+            connected: Arc::new(AtomicBool::new(false)),
+        },
+        receiver,
+    )
+}
