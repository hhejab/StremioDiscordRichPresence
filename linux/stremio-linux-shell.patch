+#[derive(Default)]
+struct Playback {
+    active: bool,
+    loading: bool,
+    paused: bool,
+    metadata: Option<Presence>,
+    source_title: Option<String>,
+    position: Option<f64>,
+    duration: Option<f64>,
+    speed: f64,
+    clock: Option<(i64, Option<i64>)>,
+}
+
+impl Playback {
+    fn presence(&self) -> Option<Presence> {
+        if !self.active {
+            return None;
+        }
+        self.metadata.clone().map(|mut presence| {
+            presence.paused = self.paused;
+            presence.timestamps = (!self.paused).then_some(self.clock).flatten();
+            presence
+        })
+    }
+
+    fn update_clock(&mut self, now: i64) {
+        if self.paused || self.loading {
+            self.clock = None;
+            return;
+        }
+        let Some(position) = self.position else {
+            return;
+        };
+        let speed = if self.speed > 0.0 { self.speed } else { 1.0 };
+        let start = now - (position / speed).floor() as i64;
+        let end = self
+            .duration
+            .map(|duration| now + ((duration - position).max(0.0) / speed).ceil() as i64);
+        // Keep stable timestamps during normal playback; update on seek or speed
+        // change. MPV emits time-pos frequently, Discord must not receive every tick.
+        if self.clock.is_none_or(|(old_start, old_end)| {
+            (old_start - start).abs() > 2
+                || match (old_end, end) {
+                    (Some(old), Some(new)) => (old - new).abs() > 2,
+                    (a, b) => a != b,
+                }
+        }) {
+            self.clock = Some((start, end));
+        }
+    }
+}
