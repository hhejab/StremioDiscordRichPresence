+#[test]
+fn worker_recovers_when_discord_starts_late_and_after_a_broken_socket() {
+    let (sender, receiver) = flume::unbounded();
+    let (events, output) = flume::unbounded();
+    let fail_write = Arc::new(AtomicBool::new(false));
+    let fail_connect = Arc::new(AtomicBool::new(true));
+    let client = FakeClient {
+        events,
+        fail_write: fail_write.clone(),
+        fail_connect: fail_connect.clone(),
+        last: Arc::new(Mutex::new(None)),
+    };
+    let worker = thread::spawn(move || {
+        run(
+            receiver,
+            Arc::new(AtomicBool::new(false)),
+            client,
+            Duration::from_millis(30),
+        )
+    });
+    let next = || output.recv_timeout(Duration::from_secs(2)).unwrap();
+    assert_eq!(next(), json!("connect"));
+    sender
+        .send(Command::Update(Some(Presence {
+            details: "A movie".into(),
+            image: None,
+            paused: true,
+            ..Presence::default()
+        })))
+        .unwrap();
+    fail_connect.store(false, Ordering::Relaxed);
+    loop {
+        if next().is_object() {
+            break;
+        }
+    }
+    fail_write.store(true, Ordering::Relaxed);
+    loop {
+        if next() == json!("close") {
+            break;
+        }
+    }
+    assert_eq!(next(), json!("connect"));
+    let restored = next();
+    assert_eq!(restored["details"], "A movie");
+    assert_eq!(restored["state"], "Paused");
+    sender.send(Command::Shutdown).unwrap();
+    worker.join().unwrap();
+}
