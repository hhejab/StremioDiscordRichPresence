+fn run<C: DiscordIpc>(
+    receiver: Receiver<Command>,
+    connected: Arc<AtomicBool>,
+    mut client: C,
+    retry_interval: Duration,
+) {
+    let mut enabled = true;
+    let mut desired: Option<Presence> = None;
+    let mut dirty = true;
+    let mut next_retry = Instant::now();
+    loop {
+        if enabled && !connected.load(Ordering::Relaxed) && Instant::now() >= next_retry {
+            next_retry = Instant::now() + retry_interval;
+            match client.connect() {
+                Ok(()) => {
+                    connected.store(true, Ordering::Relaxed);
+                    dirty = true;
+                }
+                Err(e) => debug!("Discord is unavailable: {e}"),
+            }
+        }
+        if enabled && connected.load(Ordering::Relaxed) && dirty {
+            let result = match &desired {
+                Some(presence) => client.set_activity(presence.activity()),
+                None => client.clear_activity(),
+            };
+            if let Err(e) = result {
+                warn!("Discord activity update failed; will reconnect: {e}");
+                client.close().ok();
+                connected.store(false, Ordering::Relaxed);
+            }
+            dirty = false;
+        }
+        match receiver.recv_timeout(retry_interval) {
+            Ok(Command::Update(presence)) => {
+                if desired != presence {
+                    desired = presence;
+                    dirty = true;
+                }
+            }
+            Ok(Command::Enable(value)) => {
+                if enabled != value {
+                    enabled = value;
+                    next_retry = Instant::now();
+                    if !enabled && connected.swap(false, Ordering::Relaxed) {
+                        client.clear_activity().ok();
+                        client.close().ok();
+                    }
+                }
+            }
+            Ok(Command::Shutdown) | Err(RecvTimeoutError::Disconnected) => break,
+            Err(RecvTimeoutError::Timeout) => {
+                // Refresh an active presence so a Discord restart is detected even
+                // when playback is paused and no further media events arrive.
+                dirty = desired.is_some();
+            }
+        }
+    }
+    if connected.swap(false, Ordering::Relaxed) {
+        client.clear_activity().ok();
+        client.close().ok();
+    }
+    // Do not join this worker on the UI thread: an unresponsive Discord handshake
+    // must not prevent app exit. Process exit also closes any remaining socket.
+}
