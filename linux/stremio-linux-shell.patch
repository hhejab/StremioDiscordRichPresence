+impl Presence {
+    fn activity(&self) -> Activity<'_> {
+        let hover = self.hover_text.as_deref().unwrap_or(&self.details);
+        let mut assets = Assets::new().large_text(bounded(hover));
+        if let Some(image) = &self.image {
+            assets = assets.large_image(image.clone());
+        }
+        if self.paused {
+            assets = assets
+                .small_image("https://i.imgur.com/eCUJpm9.png")
+                .small_text("Paused");
+        } else if let Some(thumbnail) = &self.thumbnail {
+            assets = assets
+                .small_image(thumbnail.clone())
+                .small_text(bounded(self.episode.as_deref().unwrap_or("Playing")));
+        } else {
+            assets = assets.small_image("https://raw.githubusercontent.com/Stremio/stremio-web/development/images/icon.png").small_text("Playing");
+        }
+        let state = match (&self.episode, self.paused) {
+            (Some(episode), true) => format!("Paused · {episode}"),
+            (Some(episode), false) => episode.clone(),
+            (None, true) => "Paused".into(),
+            (None, false) => "Watching".into(),
+        };
+        let mut activity = Activity::default()
+            .activity_type(ActivityType::Watching)
+            .details(bounded(&self.details))
+            .state(bounded(&state))
+            .assets(assets);
+        let mut buttons = vec![];
+        if let Some(url) = &self.imdb_url {
+            buttons.push(Button::new("More details", url.clone()));
+        }
+        if let Some(url) = &self.stremio_url {
+            buttons.push(Button::new("Watch on Stremio", url.clone()));
+        }
+        activity = activity.buttons(buttons);
+        if !self.paused
+            && let Some((start, end)) = self.timestamps
+        {
+            let mut timestamps = Timestamps::new().start(start);
+            if let Some(end) = end {
+                timestamps = timestamps.end(end);
+            }
+            activity = activity.timestamps(timestamps);
+        }
+        activity
+    }
+}
