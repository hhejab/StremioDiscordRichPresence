+fn bounded(value: &str) -> String {
+    let mut end = value.len().min(128);
+    while !value.is_char_boundary(end) {
+        end -= 1;
+    }
+    value[..end].to_owned()
+}
+
+fn image_url(value: Option<String>) -> Option<String> {
+    value.filter(|value| {
+        url::Url::parse(value).is_ok_and(|url| matches!(url.scheme(), "https" | "http"))
+    })
+}
